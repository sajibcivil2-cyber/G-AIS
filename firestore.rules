rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Validation Helpers ---

    function isValidUserSavedWatchlist(data, userId) {
      return data.userId == userId
        && data.symbol is string && data.symbol.size() <= 30
        && (!data.keys().hasAny(['notes']) || (data.notes is string && data.notes.size() <= 500))
        && data.createdAt is string;
    }

    function isValidBacktestReport(data, userId) {
      return data.userId == userId
        && data.strategyName is string && data.strategyName.size() <= 100
        && data.totalTrades is number
        && data.winRate is number
        && data.profitFactor is number
        && data.createdAt is string;
    }

    function isValidPriceAlert(data, userId) {
      return data.userId == userId
        && data.symbol is string && data.symbol.size() <= 30
        && data.targetPrice is number
        && data.condition is string && data.condition.size() <= 10 && data.condition.matches('^(ABOVE|BELOW)$')
        && data.createdAt is string;
    }

    function isValidUserPreference(data, userId) {
      return data.userId == userId
        && (!data.keys().hasAny(['initialCapital']) || data.initialCapital is number)
        && (!data.keys().hasAny(['positionSizePct']) || data.positionSizePct is number)
        && (!data.keys().hasAny(['maxRiskPerTradePct']) || data.maxRiskPerTradePct is number)
        && (!data.keys().hasAny(['stopLossPct']) || data.stopLossPct is number)
        && (!data.keys().hasAny(['targetProfitPct']) || data.targetProfitPct is number)
        && data.updatedAt is string;
    }

    function isValidTradeLog(data, userId) {
      return data.userId == userId
        && data.symbol is string && data.symbol.size() <= 30
        && data.entryDate is string && data.entryDate.size() <= 30
        && data.entryPrice is number
        && data.shares is number
        && data.status is string && data.status.size() <= 10 && data.status.matches('^(OPEN|CLOSED)$')
        && (!data.keys().hasAny(['exitDate']) || (data.exitDate is string && data.exitDate.size() <= 30))
        && (!data.keys().hasAny(['exitPrice']) || data.exitPrice is number)
        && (!data.keys().hasAny(['pnlBdt']) || data.pnlBdt is number)
        && (!data.keys().hasAny(['pnlPct']) || data.pnlPct is number)
        && (!data.keys().hasAny(['notes']) || (data.notes is string && data.notes.size() <= 2000))
        && data.createdAt is string
        && data.updatedAt is string;
    }

    // --- Collections ---

    // User Watchlists
    match /users/{userId}/watchlists/{watchlistId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(watchlistId) && isValidUserSavedWatchlist(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(watchlistId) && isValidUserSavedWatchlist(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().symbol == existing().symbol
        && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId) && isValidId(watchlistId);
    }

    // User Saved Backtests
    match /users/{userId}/backtests/{backtestId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(backtestId) && isValidBacktestReport(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(backtestId) && isValidBacktestReport(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId) && isValidId(backtestId);
    }

    // Price Alerts
    match /users/{userId}/alerts/{alertId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(alertId) && isValidPriceAlert(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(alertId) && isValidPriceAlert(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().symbol == existing().symbol
        && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId) && isValidId(alertId);
    }

    // User Settings / Preferences
    match /users/{userId}/settings/{settingId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(settingId) && isValidUserPreference(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(settingId) && isValidUserPreference(incoming(), userId)
        && incoming().userId == existing().userId;
      allow delete: if isOwner(userId) && isValidId(settingId);
    }

    // Trade Logs
    match /users/{userId}/tradelogs/{tradeId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(tradeId) && isValidTradeLog(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(tradeId) && isValidTradeLog(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().symbol == existing().symbol
        && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId) && isValidId(tradeId);
    }
  }
}
